# 开张机配置模板：复制为 .env 并填入真实值
OPENAI_BASE_URL=https://api.openai-next.com/v1
OPENAI_API_KEY=sk-xxxx
HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1
TEXT_MODEL=glm-5.3-flash
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
GOOFISH_EXE=D:\path\to\goofish.exe
PY_MAIN=C:\path\to\python.exe
RENDER_XHS=C:\path\to\render_xhs.py
XHS_THEME=sketch
PARALLEL_IMAGES=1
ENABLE_VIDEO=false
VIDEO_MODEL=sora-2
